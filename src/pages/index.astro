---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const music = await getCollection('music');
const projects = await getCollection('projects');
const posts = await getCollection('blog');
const settingsList = await getCollection('settings');
const site = settingsList[0]?.data;

// 首屏背景：大图或视频（都在后台「站点设置」里上传）
const heroImage = site?.heroImage || '';
const heroVideo = site?.heroVideo || '';
// 传了视频就优先用视频，图片退居为「视频加载出来之前先显示的封面」
const hasHero = heroImage !== '' || heroVideo !== '';

// 首屏大标题：拆成单个字，好让它们一个一个浮出来
const heroGreeting = 'Hi, 我是 ';
const heroName = 'Nathuris';
const heroGreetingChars = [...heroGreeting];
const heroNameChars = [...heroName];
// 给读屏软件用的完整标题（拆成单字后，视觉上是逐字动画）
const heroTitle = `${heroGreeting}${heroName}`;
const heroNameClass = hasHero ? 'text-accent-300' : 'text-accent-600 dark:text-accent-400';
// 每个字的出场时间：一个比一个晚一点点
const charDelay = (i: number) => `${(0.06 + i * 0.028).toFixed(3)}s`;

// 精选推荐：选最新的 4 首音乐 + 4 个项目
const sortByOrderAndDate = (a: any, b: any) => {
  const orderA = a.data.order ?? 0;
  const orderB = b.data.order ?? 0;
  if (orderB !== orderA) return orderB - orderA;
  return (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0);
};

const featuredMusic = music.sort(sortByOrderAndDate).slice(0, 4);

const featuredProjects = projects.sort(sortByOrderAndDate).slice(0, 4);

const recentPosts = posts
  .sort((a, b) => (b.data.date?.getTime() || 0) - (a.data.date?.getTime() || 0))
  .slice(0, 3);
---

<BaseLayout title="首页" description="Nathuris 的个人网站 — 音乐人 & 开发者，展示原创音乐与 Vibe Coding 作品。">

  <!-- Hero 区域：靠左排列。若在后台设置了背景大图，则铺满并自动压暗 -->
  <section class:list={['relative overflow-hidden', hasHero ? 'py-28 sm:py-40 lg:py-48' : 'py-24 sm:py-32 lg:py-40']}>
    {
      hasHero && (
        <div class="absolute inset-0" aria-hidden="true">
          {heroVideo ? (
            /* 背景视频：静音、循环、自动播放。
               视频本身就在动，所以不再叠加缩放动画 */
            <video
              class="h-full w-full object-cover blur-[3px]"
              src={heroVideo}
              poster={heroImage || undefined}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              data-hero-video
            ></video>
          ) : (
            /* 背景图：极缓慢地放大又缩回，像在呼吸；放大是为了盖住虚化后的毛边 */
            <img
              src={heroImage}
              alt=""
              class="fx-kenburns h-full w-full object-cover blur-[3px]"
              loading="eager"
              fetchpriority="high"
            />
          )}
          {/* 整体压暗，保证文字清晰 */}
          <div class="absolute inset-0 bg-slate-950/60" />
          {/* 左侧再加深一点，文字正好压在这一侧 */}
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/50 via-slate-950/20 to-transparent" />
        </div>
      )
    }

    <div class="container-main relative">
      <div class="max-w-3xl">
        <div
          class:list={[
            'fx-rise mb-8 h-20 w-20 overflow-hidden rounded-full',
            hasHero
              ? 'bg-white/10 ring-2 ring-white/40'
              : 'bg-accent-50 ring-1 ring-accent-200 dark:bg-accent-950 dark:ring-accent-800',
          ]}
          style="--d:0s"
        >
          {site?.avatar ? (
            <img src={site.avatar} alt="Nathuris" class="h-full w-full object-cover" />
          ) : (
            <span
              class:list={[
                'flex h-full w-full items-center justify-center text-2xl font-bold',
                hasHero ? 'text-white' : 'text-accent-600 dark:text-accent-400',
              ]}
            >
              N
            </span>
          )}
        </div>

        <h1
          aria-label={heroTitle}
          class:list={[
            'text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl',
            hasHero && 'text-white',
          ]}
        >
          <span aria-hidden="true">
            {heroGreetingChars.map((ch, i) => (
              <span class="fx-char" style={`--d:${charDelay(i)}`}>
                {ch === ' ' ? ' ' : ch}
              </span>
            ))}
            <span class:list={['whitespace-nowrap', heroNameClass]}>
              {heroNameChars.map((ch, i) => (
                <span class="fx-char" style={`--d:${charDelay(heroGreetingChars.length + i)}`}>
                  {ch}
                </span>
              ))}
            </span>
          </span>
        </h1>

        <div
          class:list={['fx-rise mt-7 h-px w-16', hasHero ? 'bg-white/50' : 'bg-accent-300 dark:bg-accent-700']}
          style="--d:0.42s"
          aria-hidden="true"
        />

        {site?.bio && (
          <p
            class:list={[
              'fx-rise mt-7 max-w-xl text-lg leading-relaxed',
              hasHero ? 'text-slate-100' : 'text-slate-600 dark:text-slate-400',
            ]}
            style="--d:0.52s"
          >
            {site.bio}
          </p>
        )}

        <div class="fx-rise mt-10 flex flex-wrap items-center gap-3" style="--d:0.62s">
          <a href="/music/" class="btn btn-primary">我的音乐</a>
          <a href="/projects/" class:list={['btn', hasHero ? 'btn-outline-light' : 'btn-outline']}>
            我的项目
          </a>
          <a href="/contact/" class:list={['btn', hasHero ? 'btn-outline-light' : 'btn-outline']}>
            联系我
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 精选音乐 -->
  {
    featuredMusic.length > 0 && (
      <section class="border-t border-slate-100 py-20 sm:py-24 dark:border-slate-800">
        <div class="container-main">
          <div class="reveal mb-12 flex items-end justify-between gap-6">
            <div>
              <h2 class="section-title">音乐作品</h2>
              <p class="mt-3 text-slate-500 dark:text-slate-400">原创音乐精选</p>
            </div>
            <a href="/music/" class="btn btn-outline text-sm">
              全部作品 →
            </a>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {featuredMusic.map((item, i) => (
              <article class="card group reveal" style={`--d:${(i * 0.09).toFixed(2)}s`}>
                <a href={`/music/${item.id}/`} class="no-underline">
                  {item.data.coverImage ? (
                    <div class="mb-3 aspect-square overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800">
                      <img src={item.data.coverImage} alt={item.data.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                    </div>
                  ) : (
                    <div class="mb-3 flex aspect-square items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-800">
                      <svg class="h-10 w-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                      </svg>
                    </div>
                  )}
                  <h3 class="font-semibold text-slate-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400">{item.data.title}</h3>
                </a>
                {item.data.description && (
                  <p class="mt-1 line-clamp-1 text-xs text-slate-500 dark:text-slate-400">{item.data.description}</p>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 精选项目 -->
  {
    featuredProjects.length > 0 && (
      <section class="border-t border-slate-100 py-20 sm:py-24 dark:border-slate-800">
        <div class="container-main">
          <div class="reveal mb-12 flex items-end justify-between gap-6">
            <div>
              <h2 class="section-title">项目作品</h2>
              <p class="mt-3 text-slate-500 dark:text-slate-400">Vibe Coding 精选项目</p>
            </div>
            <a href="/projects/" class="btn btn-outline text-sm">
              全部项目 →
            </a>
          </div>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {featuredProjects.map((item, i) => (
              <article class="card group reveal" style={`--d:${(i * 0.09).toFixed(2)}s`}>
                <a href={`/projects/${item.id}/`} class="no-underline">
                  {item.data.image ? (
                    <div class="mb-3 aspect-video overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-800">
                      <img src={item.data.image} alt={item.data.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                    </div>
                  ) : (
                    <div class="mb-3 flex aspect-video items-center justify-center rounded-lg bg-slate-100 dark:bg-slate-800">
                      <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                      </svg>
                    </div>
                  )}
                  <h3 class="font-semibold text-slate-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400">{item.data.title}</h3>
                </a>
                {item.data.description && (
                  <p class="mt-1 line-clamp-1 text-xs text-slate-500 dark:text-slate-400">{item.data.description}</p>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 近期博客 -->
  {
    recentPosts.length > 0 && (
      <section class="border-t border-slate-100 py-20 sm:py-24 dark:border-slate-800">
        <div class="container-main">
          <div class="reveal mb-12 flex items-end justify-between gap-6">
            <div>
              <h2 class="section-title">近期动态</h2>
              <p class="mt-3 text-slate-500 dark:text-slate-400">最新文章和分享</p>
            </div>
            <a href="/blog/" class="btn btn-outline text-sm">
              全部文章 →
            </a>
          </div>
          <div class="space-y-5">
            {recentPosts.map((post, i) => (
              <a
                href={`/blog/${post.id}/`}
                class="card reveal flex flex-col no-underline hover:border-accent-200 dark:hover:border-accent-800 sm:flex-row sm:items-center sm:justify-between"
                style={`--d:${(i * 0.09).toFixed(2)}s`}
              >
                <div>
                  <h3 class="font-semibold text-slate-900 dark:text-white">{post.data.title}</h3>
                  {post.data.description && (
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{post.data.description}</p>
                  )}
                </div>
                <span class="mt-2 shrink-0 text-xs text-slate-400 sm:mt-0">
                  {post.data.date?.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 空状态（当所有集合都为空时显示） -->
  {
    featuredMusic.length === 0 && featuredProjects.length === 0 && (
      <section class="border-t border-slate-100 py-20 sm:py-24 dark:border-slate-800">
        <div class="container-main text-center">
          <p class="text-slate-400 dark:text-slate-500">
            内容正在准备中，请稍后再来。
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
