---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = `${title} | Nathuris`;
---

<!doctype html>
<!--
  class 直接写在 HTML 上，不靠脚本判断：
  - dark：第一帧渲染出来就是深色，切页面不会闪一下白的
  - js-reveal：标记「待浮现的元素先藏起来」。这一条必须写死在这里，
    因为切换页面时 Astro 会把新页面的 html 属性换进来——如果靠脚本临时添加，
    换页那一瞬间标记不存在，卡片会先全部显示、再集体消失，也就是「闪一下」。
  - js-hero：标记「首屏视频先藏起来，等它真的开始播了再淡入」。同样必须写死在这里。
-->
<html lang="zh-CN" class="dark js-reveal js-hero" transition:animate="fade">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || 'Nathuris 的个人网站 — 音乐人 & 开发者'} />
    <meta name="theme-color" content="#020617" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* 字体样式表：故意做成「不阻塞」。
        外部样式表直接写在 head 里会让浏览器停下来等它下载完，才继续往下读页面。
        而它是从 Google 的服务器取的，大陆访问经常连不上——连不上就得干等到超时。
        这几秒里浏览器根本还没读到底部的视频，视频的下载也没开始，
        表现就是「页面打开了，视频却半天不动」。
        用 media="print" 让浏览器认为当前用不上它、不阻塞页面，
        等它真的下回来了再由 onload 切回 all。 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <ClientRouter />
    <noscript>
      {/* 浏览器不执行脚本时，把「待浮现」的隐藏状态取消，保证内容完整可见 */}
      <style>
        .js-reveal .reveal {
          opacity: 1 !important;
          translate: none !important;
          scale: none !important;
        }
        .js-hero video[data-hero-fade] {
          opacity: 1 !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      let revealObserver: IntersectionObserver | undefined;

      // 滚动到哪，哪一块才浮现
      function initReveal() {
        revealObserver?.disconnect();
        const els = document.querySelectorAll('.reveal');
        if (els.length === 0) return;

        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target); // 出现一次就够了，不重复播放
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        els.forEach((el) => revealObserver?.observe(el));
      }

      // 首屏背景视频。
      // 视频一开始是完全透明的——那块区域先空着（或显示后台设的封面图）；
      // 等它真的开始播放了，才加上 .is-playing 淡入出来——
      // 这样就不会看到「先冒出一帧静止画面、过一会儿才动」。
      function initHeroVideo() {
        const video = document.querySelector('video[data-hero-video]');
        if (!(video instanceof HTMLVideoElement)) return;
        video.muted = true; // 部分浏览器只认脚本里设的静音，HTML 属性不够

        const show = () => video.classList.add('is-playing');

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // 访客开了「减少动态效果」：不放视频，直接把第一帧亮出来
          video.pause();
          video.removeAttribute('autoplay');
          show();
          return;
        }

        if (!video.paused) {
          // 已经在播了（playing 事件可能早于监听器挂上），直接显示
          show();
          return;
        }

        video.addEventListener('playing', show, { once: true });
        video.play().catch(() => {
          /* 自动播放被浏览器拦下（例如开了低电量模式）：先保持隐藏不显示，
             等访客随便点一下或滑一下再试一次——免得那块区域一直空着 */
          const retry = () => {
            window.removeEventListener('pointerdown', retry);
            window.removeEventListener('scroll', retry);
            video.play().catch(() => {});
          };
          window.addEventListener('pointerdown', retry, { passive: true });
          window.addEventListener('scroll', retry, { passive: true });
        });
      }

      // Cloudflare 会把页面里的邮箱编码成一段乱码，再靠它自己的脚本在
      // 「页面首次加载」时还原成真实地址。而我们切换页面是不重新加载整页的，
      // 那个脚本不会重跑，邮箱就会一直显示成 [email protected] 这种占位符。
      // 这里自己解一次码。
      function cfDecodeEmail(hex) {
        if (!hex || hex.length < 4) return '';
        const key = parseInt(hex.slice(0, 2), 16);
        if (Number.isNaN(key)) return '';
        let out = '';
        for (let i = 2; i < hex.length; i += 2) {
          out += String.fromCharCode(parseInt(hex.slice(i, i + 2), 16) ^ key);
        }
        return out;
      }

      function decodeProtectedEmails() {
        document.querySelectorAll('[data-cfemail]').forEach((el) => {
          const email = cfDecodeEmail(el.getAttribute('data-cfemail') || '');
          if (!email) return;
          el.textContent = email;
          const link = el.closest('a');
          if (link) link.setAttribute('href', 'mailto:' + email);
        });

        // 万一某个链接没有那个标记，就直接从链接地址本身解
        document.querySelectorAll('a[href^="/cdn-cgi/l/email-protection#"]').forEach((link) => {
          if (link.querySelector('[data-cfemail]')) return;
          const email = cfDecodeEmail((link.getAttribute('href') || '').split('#')[1] || '');
          if (!email) return;
          link.setAttribute('href', 'mailto:' + email);
          link.textContent = email;
        });
      }

      function setup() {
        // 打开/切换页面时就已经在屏幕里的内容，直接显示、不播浮现动画。
        // 否则切换页面时会先看到一片空白（内容还藏着），再慢慢浮现出来。
        // 浮现动画只留给「滚动之后才进入视野」的内容。
        const pending = Array.from(document.querySelectorAll('.reveal:not(.is-visible)'));
        const inView = pending.filter((el) => el.getBoundingClientRect().top < window.innerHeight);
        if (inView.length > 0) {
          document.documentElement.classList.add('no-reveal-anim');
          inView.forEach((el) => el.classList.add('is-visible'));
          // 强制浏览器先按「已显示」的状态排版一次，再恢复动画
          void document.documentElement.offsetHeight;
          requestAnimationFrame(() => {
            document.documentElement.classList.remove('no-reveal-anim');
          });
        }

        initReveal();
        initHeroVideo();
        decodeProtectedEmails();
      }

      // 直接跑一次（首屏），并在每次切换页面后再跑一次
      setup();
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>
