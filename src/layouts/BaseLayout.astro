---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = `${title} | Nathuris`;
---

<!doctype html>
<!--
  class 直接写在 HTML 上，不靠脚本判断：
  - dark：第一帧渲染出来就是深色，切页面不会闪一下白的
  - js-reveal：标记「待浮现的元素先藏起来」。这一条必须写死在这里，
    因为切换页面时 Astro 会把新页面的 html 属性换进来——如果靠脚本临时添加，
    换页那一瞬间标记不存在，卡片会先全部显示、再集体消失，也就是「闪一下」。
-->
<html lang="zh-CN" class="dark js-reveal" transition:animate="fade">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || 'Nathuris 的个人网站 — 音乐人 & 开发者'} />
    <meta name="theme-color" content="#020617" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <ClientRouter />
    <noscript>
      {/* 浏览器不执行脚本时，把「待浮现」的隐藏状态取消，保证内容完整可见 */}
      <style>
        .js-reveal .reveal {
          opacity: 1 !important;
          translate: none !important;
          scale: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      let revealObserver: IntersectionObserver | undefined;

      // 滚动到哪，哪一块才浮现
      function initReveal() {
        revealObserver?.disconnect();
        const els = document.querySelectorAll('.reveal');
        if (els.length === 0) return;

        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target); // 出现一次就够了，不重复播放
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        els.forEach((el) => revealObserver?.observe(el));
      }

      // 首屏背景视频：如果访客的系统开了「减少动态效果」，就不要播放
      function initHeroVideo() {
        const video = document.querySelector('video[data-hero-video]');
        if (!(video instanceof HTMLVideoElement)) return;
        video.muted = true; // 部分浏览器只认脚本里设的静音，HTML 属性不够
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          video.pause();
          video.removeAttribute('autoplay');
        } else {
          video.play().catch(() => {
            /* 自动播放被浏览器拦下时什么也不做，画面停在封面帧 */
          });
        }
      }

      function setup() {
        initReveal();
        initHeroVideo();
      }

      // 直接跑一次（首屏），并在每次切换页面后再跑一次
      setup();
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>
